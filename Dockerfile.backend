FROM node:18-alpine
WORKDIR /usr/src/app
COPY backend/package*.json ./
# Use npm install in the image to avoid failing when lockfile and package.json
# are out of sync on the build host. This ensures required runtime deps are
# installed inside the production image.
RUN npm install --no-audit --no-fund
COPY backend/ .
ENV NODE_ENV=production
EXPOSE 4000
CMD ["node", "app.js"]
